# ─── Food Tailor Environment Configuration ───────────────────
# Copy this file to server/.env and adjust configuration as needed.

# Database (Amazon DynamoDB)
DYNAMODB_TABLE_NAME=food_tailor
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localKey
AWS_SECRET_ACCESS_KEY=localSecret

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Authentication (JWT Secrets — must be 64+ char random keys in production)
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-1234567890abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-fedcba0987654321
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI Menu Intelligence Provider
# Options: fallback (deterministic rule-based) | huggingface | ollama | vllm
AI_PROVIDER=fallback
AI_MODEL_PRIMARY=mistralai/Mistral-7B-Instruct-v0.3
AI_MODEL_FALLBACK=microsoft/Phi-3-mini-4k-instruct
HF_TOKEN=your_huggingface_api_token_here
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000

# Payment Provider
# Options: mock (local development/testing) | razorpay (live gateway)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Optional Cache / Queue
REDIS_URL=redis://localhost:6379
