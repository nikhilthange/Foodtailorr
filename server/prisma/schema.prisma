generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  PARTNER
}

enum DietaryType {
  VEG
  NON_VEG
  VEGAN
  ALL
}

enum SpiceLevel {
  MILD
  MEDIUM
  SPICY
  EXTRA_SPICY
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PENDING_PARTNER
  ACCEPTED
  REJECTED
  PREPARING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ─── Users & Auth ────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  preferences   UserPreference?
  addresses     Address[]
  orders        Order[]
  savedMenus    SavedMenu[]
  refreshTokens RefreshToken[]
  partner       Partner?

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserPreference {
  id                  String      @id @default(uuid())
  userId              String      @unique @map("user_id")
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryType         DietaryType @default(ALL) @map("dietary_type")
  spiceLevel          SpiceLevel  @default(MEDIUM) @map("spice_level")
  allergies           String[]    @default([])
  dislikedIngredients String[]    @default([]) @map("disliked_ingredients")
  cuisinePreferences  String[]    @default([]) @map("cuisine_preferences")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("addresses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Partners (Brands / Restaurants) ─────────────────

model Partner {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String   @map("business_name")
  tagline          String?
  description      String?
  cuisine          String
  whyWePicked      String?  @map("why_we_picked")
  established      Int?
  logoUrl          String?  @map("logo_url")
  isApproved       Boolean  @default(false) @map("is_approved")
  isActive         Boolean  @default(true) @map("is_active")
  minOrderAmount   Int?     @map("min_order_amount")
  maxEventCapacity Int?     @map("max_event_capacity")
  serviceAreas     String[] @default([]) @map("service_areas")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  dishes     Dish[]
  orderItems OrderItem[]

  @@index([isApproved, isActive])
  @@map("partners")
}

// ─── Catalog ─────────────────────────────────────────

model Cuisine {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cuisines")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  dishes Dish[]

  @@map("categories")
}

model Dish {
  id           String     @id @default(uuid())
  partnerId    String     @map("partner_id")
  partner      Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  categoryId   String     @map("category_id")
  category     Category   @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  pricePerHead Int        @map("price_per_head")
  isVeg        Boolean    @default(false) @map("is_veg")
  isSignature  Boolean    @default(false) @map("is_signature")
  isAvailable  Boolean    @default(true) @map("is_available")
  servesMin    Int        @default(10) @map("serves_min")
  spiceLevel   SpiceLevel @default(MEDIUM) @map("spice_level")
  allergens    String[]   @default([])
  tags         String[]   @default([])
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  orderItems          OrderItem[]
  savedMenuItems      SavedMenuItem[]
  recommendationItems AIRecommendationItem[]

  @@index([partnerId])
  @@index([categoryId])
  @@index([isVeg])
  @@index([isAvailable])
  @@index([pricePerHead])
  @@map("dishes")
}

model Occasion {
  id          String   @id @default(uuid())
  name        String   @unique
  icon        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  orders            Order[]
  aiRecommendations AIRecommendation[]

  @@map("occasions")
}

// ─── AI Recommendations ──────────────────────────────

model AIRecommendation {
  id            String      @id @default(uuid())
  userId        String?     @map("user_id")
  occasionId    String?     @map("occasion_id")
  occasion      Occasion?   @relation(fields: [occasionId], references: [id])
  guestCount    Int         @map("guest_count")
  budgetPerHead Int         @map("budget_per_head")
  dietaryType   DietaryType @default(ALL) @map("dietary_type")
  spiceLevel    SpiceLevel  @default(MEDIUM) @map("spice_level")
  allergies     String[]    @default([])
  provider      String
  model         String?
  promptSent    String?     @map("prompt_sent")
  rawResponse   String?     @map("raw_response")
  isFallback    Boolean     @default(false) @map("is_fallback")
  status        String      @default("completed")
  errorMessage  String?     @map("error_message")
  durationMs    Int?        @map("duration_ms")
  createdAt     DateTime    @default(now()) @map("created_at")

  items AIRecommendationItem[]

  @@index([userId])
  @@index([createdAt])
  @@map("ai_recommendations")
}

model AIRecommendationItem {
  id               String           @id @default(uuid())
  recommendationId String           @map("recommendation_id")
  recommendation   AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  dishId           String           @map("dish_id")
  dish             Dish             @relation(fields: [dishId], references: [id])
  quantity         Int
  reason           String?
  packageName      String           @map("package_name")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([recommendationId])
  @@map("ai_recommendation_items")
}

// ─── Orders ──────────────────────────────────────────

model Order {
  id              String        @id @default(uuid())
  orderRef        String        @unique @map("order_ref")
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id])
  occasionId      String?       @map("occasion_id")
  occasion        Occasion?     @relation(fields: [occasionId], references: [id])
  guestCount      Int           @map("guest_count")
  budgetPerHead   Int?          @map("budget_per_head")
  dietaryType     DietaryType   @default(ALL) @map("dietary_type")
  totalAmount     Int           @map("total_amount")
  status          OrderStatus   @default(DRAFT)
  eventDate       DateTime?     @map("event_date")
  venueAddress    String?       @map("venue_address")
  contactName     String        @map("contact_name")
  contactPhone    String?       @map("contact_phone")
  contactEmail    String?       @map("contact_email")
  notes           String?
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  paymentProvider String?       @map("payment_provider")
  paymentRef      String?       @map("payment_ref")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([orderRef])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId       String   @map("dish_id")
  dish         Dish     @relation(fields: [dishId], references: [id])
  partnerId    String   @map("partner_id")
  partner      Partner  @relation(fields: [partnerId], references: [id])
  quantity     Int
  pricePerHead Int      @map("price_per_head")
  totalPrice   Int      @map("total_price")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([partnerId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String       @map("order_id")
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String?      @map("changed_by")
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_status_history")
}

// ─── Saved Menus ─────────────────────────────────────

model SavedMenu {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  occasionId   String?  @map("occasion_id")
  guestCount   Int      @map("guest_count")
  totalPerHead Int      @map("total_per_head")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items SavedMenuItem[]

  @@index([userId])
  @@map("saved_menus")
}

model SavedMenuItem {
  id          String    @id @default(uuid())
  savedMenuId String    @map("saved_menu_id")
  savedMenu   SavedMenu @relation(fields: [savedMenuId], references: [id], onDelete: Cascade)
  dishId      String    @map("dish_id")
  dish        Dish      @relation(fields: [dishId], references: [id])
  quantity    Int
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([savedMenuId])
  @@map("saved_menu_items")
}

// ─── Audit ───────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, action])
  @@index([createdAt])
  @@map("audit_logs")
}
