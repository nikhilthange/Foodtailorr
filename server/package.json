{
  "name": "food-tailor-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --watch-path=src src/index.js",
    "db:init": "node src/config/initTables.js",
    "db:seed": "node src/config/seedDynamo.js",
    "db:seed:dynamo": "node src/config/seedDynamo.js",
    "test": "node --test tests/**/*.test.js",
    "test:e2e": "node --test tests/integration/**/*.test.js",
    "setup": "node src/config/seedDynamo.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1126.0",
    "@aws-sdk/lib-dynamodb": "^3.1126.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "razorpay": "^2.9.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "dynalite": "^4.0.0"
  }
}
