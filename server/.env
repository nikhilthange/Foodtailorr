# ─── Database (Amazon DynamoDB) ──────────────────────
DYNAMODB_TABLE_NAME=food_tailor
# DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ─── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-random-64-char-secret-key-for-access-tokens
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-char-secret-for-refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── AI Provider ─────────────────────────────────────
# Options: huggingface | ollama | vllm | fallback
AI_PROVIDER=fallback

# Primary & fallback model names
AI_MODEL_PRIMARY=mistralai/Mistral-7B-Instruct-v0.3
AI_MODEL_FALLBACK=microsoft/Phi-3-mini-4k-instruct

# HuggingFace Inference API
HF_TOKEN=hf_your_token_here

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# vLLM (self-hosted OpenAI-compatible)
VLLM_BASE_URL=http://localhost:8000

# ─── Payment ─────────────────────────────────────────
# Options: mock (dev only) | razorpay | stripe
PAYMENT_PROVIDER=mock

# Razorpay (uncomment and configure for production live gateway)
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_change_this_to_key_id
# RAZORPAY_KEY_SECRET=change_this_to_key_secret
# RAZORPAY_WEBHOOK_SECRET=change_this_to_webhook_secret

REDIS_URL=redis://localhost:6379
